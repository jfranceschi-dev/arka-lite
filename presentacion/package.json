{
  "name": "arka-lite-presentacion",
  "private": true,
  "version": "1.0.0",
  "description": "Presentación web, laboratorio conectado a las API y generador PPTX de ARKA-Lite.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "tokens": "node diseno/generar-css.ts",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validar": "node contenido/validar.ts",
    "test": "vitest run",
    "pptx": "node generador-pptx/cli.ts",
    "verificar-pptx": "node generador-pptx/verificar.ts",
    "guiones": "node guiones/generar.ts",
    "todo": "npm run validar && npm run typecheck && npm test && npm run build && npm run pptx && npm run verificar-pptx && npm run guiones"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
